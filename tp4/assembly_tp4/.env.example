# ============================================================================
# Dog Bowl Detector - Configuração da notificação por WhatsApp (Twilio)
# ----------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha com as suas próprias credenciais.
# O arquivo ".env" NÃO deve ser versionado (já está no .gitignore).
# ============================================================================

# Credenciais da sua conta Twilio (https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=seu_account_sid_aqui
TWILIO_AUTH_TOKEN=seu_auth_token_aqui

# Número de origem: o número/sandbox de WhatsApp da Twilio (formato E.164)
# No sandbox padrão da Twilio costuma ser +14155238886
WHATSAPP_NUMBER_FROM=+14155238886

# Número de destino: SEU WhatsApp, que receberá o alerta (formato E.164)
# Ex.: +55 (21) 98297-4271 -> +5521982974271
WHATSAPP_NUMBER_TO=+55XXXXXXXXXXX
