# build.tcl — script mínimo para gw_sh (Gowin Tcl Command Line Console)
# Uso: gw_sh build.tcl
# Adapte device, arquivos e nomes de saída para o seu projeto.

# Arquivos-fonte RTL (repita add_file para cada arquivo)
add_file -type verilog "rtl/top.v"
# add_file -type verilog "rtl/outro_modulo.v"

# Constraint física (obrigatória) e de timing (recomendada desde o início do projeto)
add_file -type cst "constraints/top.cst"
add_file -type sdc "constraints/top.sdc"

# Ajuste para o part number exato da sua placa (confira no wiki da Sipeed ou na etiqueta do chip)
set_device -name GW1NSR-4C GW1NSR-LV4CQN48PC7/I6

# Usa o sintetizador nativo da Gowin (não o Yosys open source)
set_option -synthesis_tool gowinsynthesis
set_option -output_base_name top
set_option -gen_text_timing_rpt 1

# Roda síntese + place-and-route + geração de bitstream
run all

# Depois de rodar, confira build/top.rpt.txt (ou similar) para o relatório de timing
# antes de considerar o build validado — "run all" sem erro não garante timing fechado.
